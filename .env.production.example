# Production template
# Generate a secure key once:
# python -c "import secrets; print(secrets.token_urlsafe(64))"

DJANGO_DEV_MODE=false
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-generated-secret

# Use your real domains only (comma-separated)
DJANGO_ALLOWED_HOSTS=monosaccharide180.com,www.monosaccharide180.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://monosaccharide180.com,https://www.monosaccharide180.com
# Tailscale 직접 접속을 운영에서도 허용하려면 아래에 tailnet 도메인/IP 추가
# 예: DJANGO_ALLOWED_HOSTS=monosaccharide180.com,100.x.x.x,my-macmini.tailnet.ts.net

# If running behind nginx / reverse proxy, keep true.
DJANGO_USE_X_FORWARDED_PROTO=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
DJANGO_SECURE_REFERRER_POLICY=same-origin

# External API timeout (seconds)
WP_REQUEST_TIMEOUT=5
WP_CACHE_TIMEOUT=300
WP_SITEMAP_CACHE_TIMEOUT=3600
# WordPress (port 4080) API endpoint on the same host
WP_BASE_URL=http://127.0.0.1:4080/wp-json/wp/v2
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 예: https://monosaccharide180.com/auth/google/callback/
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_TIMEOUT=8
GA4_MEASUREMENT_ID=
# AdSense pub ID (pub-... 또는 숫자만 입력 가능)
ADSENSE_PUBLISHER_ID=
# 기본값을 강제로 바꾸고 싶을 때만 사용 (일반적으로 비워둠)
ADSENSE_ADS_TXT_ENTRY=

# Gunicorn runtime (used by gunicorn.conf.py)
GUNICORN_BIND=127.0.0.1:4000
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_KEEPALIVE=5
GUNICORN_LOGLEVEL=info

# Game API validation / abuse protection
MAX_2048_SCORE=2000000
MIN_REACTION_SCORE=50
MAX_REACTION_SCORE=3000
GAME_RANK_POST_RATE_LIMIT=10
GAME_RANK_POST_RATE_WINDOW=60
KKOMANTLE_POST_RATE_LIMIT=45
KKOMANTLE_POST_RATE_WINDOW=60
KKOMANTLE_MAX_WORD_LENGTH=30
KKOMANTLE_WORD_REGEX=^[0-9A-Za-z가-힣_]+$
KKOMANTLE_HISTORY_START_DATE=2026-02-18
KKOMANTLE_HISTORY_MAX_DAYS=30
KKOMANTLE_HISTORY_RATE_LIMIT=20
KKOMANTLE_HISTORY_RATE_WINDOW=60
KKOMANTLE_CHALLENGE_MAX_ATTEMPTS=10
KKOMANTLE_CHALLENGE_HINT_RANKS=25,30,35
KKOMANTLE_CHALLENGE_RANK_LIMIT=10
KKOMANTLE_CHALLENGE_POST_RATE_LIMIT=45
KKOMANTLE_CHALLENGE_POST_RATE_WINDOW=60
KKOMANTLE_WHITELIST_PATH=core/data/kkomantle_whitelist.txt
KKOMANTLE_MODEL_CANDIDATE_TOPN=5000
KKOMANTLE_MOST_SIMILAR_TOPN=6000
KKOMANTLE_TOP_WORD_LIMIT=3000
NIKL_API_KEY=
NIKL_OPENDICT_API_KEY=
NIKL_STDICT_API_KEY=
