# Local development defaults
DJANGO_DEV_MODE=true
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-dev-secret-key
# Tailscale 원격 개발이면 '*' 유지 권장
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional security flags (normally only enabled in production)
DJANGO_USE_X_FORWARDED_PROTO=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_SECURE_REFERRER_POLICY=same-origin

# External API timeout (seconds)
WP_REQUEST_TIMEOUT=5
# WordPress (port 4080) API endpoint
WP_BASE_URL=http://127.0.0.1:4080/wp-json/wp/v2
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 비워두면 현재 도메인 기준 /auth/google/callback/ 을 자동 사용
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_TIMEOUT=8
GA4_MEASUREMENT_ID=
# AdSense pub ID만 넣으면 자동으로 ca-pub/pub 형식 모두 처리됨
# 예: ADSENSE_PUBLISHER_ID=pub-1234567890123456
ADSENSE_PUBLISHER_ID=
# 필요 시 ads.txt 기본값 override 가능
# 예: ADSENSE_ADS_TXT_ENTRY=google.com, pub-1234567890123456, DIRECT, f08c47fec0942fa0
ADSENSE_ADS_TXT_ENTRY=

# Gunicorn runtime (used when running with gunicorn)
GUNICORN_BIND=127.0.0.1:4000
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_KEEPALIVE=5
GUNICORN_LOGLEVEL=info

# Game API validation / abuse protection
MAX_2048_SCORE=2000000
MIN_REACTION_SCORE=50
MAX_REACTION_SCORE=3000
GAME_RANK_POST_RATE_LIMIT=10
GAME_RANK_POST_RATE_WINDOW=60
KKOMANTLE_POST_RATE_LIMIT=45
KKOMANTLE_POST_RATE_WINDOW=60
KKOMANTLE_MAX_WORD_LENGTH=30
KKOMANTLE_WORD_REGEX=^[0-9A-Za-z가-힣_]+$
KKOMANTLE_HISTORY_START_DATE=2026-02-18
KKOMANTLE_HISTORY_MAX_DAYS=30
KKOMANTLE_HISTORY_RATE_LIMIT=20
KKOMANTLE_HISTORY_RATE_WINDOW=60
KKOMANTLE_CHALLENGE_MAX_ATTEMPTS=10
KKOMANTLE_CHALLENGE_HINT_RANKS=25,30,35
KKOMANTLE_CHALLENGE_RANK_LIMIT=10
KKOMANTLE_CHALLENGE_POST_RATE_LIMIT=45
KKOMANTLE_CHALLENGE_POST_RATE_WINDOW=60
KKOMANTLE_WHITELIST_PATH=core/data/kkomantle_whitelist.txt
KKOMANTLE_MODEL_CANDIDATE_TOPN=5000
KKOMANTLE_MOST_SIMILAR_TOPN=6000
KKOMANTLE_TOP_WORD_LIMIT=3000
NIKL_API_KEY=
NIKL_OPENDICT_API_KEY=
NIKL_STDICT_API_KEY=
